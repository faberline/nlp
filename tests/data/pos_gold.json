  {"genre": "novel", "lang": "mixed", "text": "他 said 不要。", "tokens": [["他", "PRON"], ["said", "VERB"], ["不", "ADV"], ["要", "VERB"], ["。", "PUNCT"]]},
  {"genre": "paper", "lang": "en", "text": "We propose a novel method for parsing sentences.", "tokens": [["We", "PRON"], ["propose", "VERB"], ["a", "DET"], ["novel", "ADJ"], ["method", "NOUN"], ["for", "ADP"], ["parsing", "NOUN"], ["sentences", "NOUN"], [".", "PUNCT"]]},
  {"genre": "paper", "lang": "en", "text": "The model is trained on two corpora.", "tokens": [["The", "DET"], ["model", "NOUN"], ["is", "AUX"], ["trained", "VERB"], ["on", "ADP"], ["two", "NUM"], ["corpora", "NOUN"], [".", "PUNCT"]]},
  {"genre": "paper", "lang": "en", "text": "The results are consistent with prior work [2].", "tokens": [["The", "DET"], ["results", "NOUN"], ["are", "AUX"], ["consistent", "ADJ"], ["with", "ADP"], ["prior", "ADJ"], ["work", "NOUN"], ["[2]", "X"], [".", "PUNCT"]]},
