  {"genre": "novel", "lang": "en", "text": "They'll stay here until the storm passes.", "tokens": [["They", "PRON"], ["'ll", "AUX"], ["stay", "VERB"], ["here", "ADV"], ["until", "ADP"], ["the", "DET"], ["storm", "NOUN"], ["passes", "VERB"], [".", "PUNCT"]]},
  {"genre": "novel", "lang": "en", "text": "Nothing moved in the dark room, not even the cat.", "tokens": [["Nothing", "PRON"], ["moved", "VERB"], ["in", "ADP"], ["the", "DET"], ["dark", "ADJ"], ["room", "NOUN"], [",", "PUNCT"], ["not", "PART"], ["even", "ADV"], ["the", "DET"], ["cat", "NOUN"], [".", "PUNCT"]]},
  {"genre": "novel", "lang": "zh", "text": "他沒有回頭，只是把門關上了。", "tokens": [["他", "PRON"], ["沒有", "ADV"], ["回頭", "VERB"], ["，", "PUNCT"], ["只是", "ADV"], ["把", "ADP"], ["門", "NOUN"], ["關上", "VERB"], ["了", "PART"], ["。", "PUNCT"]]},
  {"genre": "novel", "lang": "zh", "text": "雨停了，街道很安靜。", "tokens": [["雨", "NOUN"], ["停", "VERB"], ["了", "PART"], ["，", "PUNCT"], ["街道", "NOUN"], ["很", "ADV"], ["安靜", "ADJ"], ["。", "PUNCT"]]},
  {"genre": "novel", "lang": "zh", "text": "她站著，望向遠處的山。", "tokens": [["她", "PRON"], ["站", "VERB"], ["著", "PART"], ["，", "PUNCT"], ["望向", "VERB"], ["遠處", "NOUN"], ["的", "PART"], ["山", "NOUN"], ["。", "PUNCT"]]},
  {"genre": "novel", "lang": "zh", "text": "老人慢慢地走進屋子。", "tokens": [["老人", "NOUN"], ["慢慢", "ADV"], ["地", "PART"], ["走進", "VERB"], ["屋子", "NOUN"], ["。", "PUNCT"]]},
  {"genre": "novel", "lang": "zh", "text": "那天晚上，我們都很累。", "tokens": [["那天", "NOUN"], ["晚上", "NOUN"], ["，", "PUNCT"], ["我們", "PRON"], ["都", "ADV"], ["很", "ADV"], ["累", "ADJ"], ["。", "PUNCT"]]},
  {"genre": "novel", "lang": "zh", "text": "燈突然滅了。", "tokens": [["燈", "NOUN"], ["突然", "ADV"], ["滅", "VERB"], ["了", "PART"], ["。", "PUNCT"]]},
  {"genre": "novel", "lang": "zh", "text": "他問：「你還好嗎？」", "tokens": [["他", "PRON"], ["問", "VERB"], ["：", "PUNCT"], ["「", "PUNCT"], ["你", "PRON"], ["還", "ADV"], ["好", "ADJ"], ["嗎", "PART"], ["？", "PUNCT"], ["」", "PUNCT"]]},
  {"genre": "novel", "lang": "mixed", "text": "我說 hello，他沒回答。", "tokens": [["我", "PRON"], ["說", "VERB"], ["hello", "INTJ"], ["，", "PUNCT"], ["他", "PRON"], ["沒", "ADV"], ["回答", "VERB"], ["。", "PUNCT"]]},
  {"genre": "novel", "lang": "mixed", "text": "The 老師 said 很好。", "tokens": [["The", "DET"], ["老師", "NOUN"], ["said", "VERB"], ["很", "ADV"], ["好", "ADJ"], ["。", "PUNCT"]]},
  {"genre": "novel", "lang": "mixed", "text": "她 bought 了 apples。", "tokens": [["她", "PRON"], ["bought", "VERB"], ["了", "PART"], ["apples", "NOUN"], ["。", "PUNCT"]]},
  {"genre": "novel", "lang": "mixed", "text": "我的 laptop 壞了。", "tokens": [["我", "PRON"], ["的", "PART"], ["laptop", "NOUN"], ["壞", "ADJ"], ["了", "PART"], ["。", "PUNCT"]]},
  {"genre": "novel", "lang": "mixed", "text": "我們 in 台北 見面。", "tokens": [["我們", "PRON"], ["in", "ADP"], ["台北", "PROPN"], ["見面", "VERB"], ["。", "PUNCT"]]},
